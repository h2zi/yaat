{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "YAAT 主窗口最小权限 / Least-privilege capability for the YAAT main window",
  "windows": ["main"],
  "permissions": [
    "allow-bootstrap",
    "allow-cli-status-refresh",
    "allow-app-update-check",
    "allow-app-update-install",
    "allow-app-update-cancel",
    "allow-provider-create",
    "allow-provider-update",
    "allow-provider-credential-get",
    "allow-provider-models-fetch",
    "allow-provider-delete",
    "allow-provider-activate",
    "allow-provider-global-deactivate",
    "allow-provider-login",
    "allow-provider-capture",
    "allow-provider-import-preview",
    "allow-provider-import-commit",
    "allow-profile-launch",
    "allow-usage-query",
    "allow-usage-rescan",
    "allow-usage-cancel",
    "allow-settings-update",
    "allow-history-preview",
    "allow-history-apply",
    "allow-history-cancel",
    "allow-history-sync-status",
    "dialog:allow-open"
  ]
}
